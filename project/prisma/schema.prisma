// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  nickname      String?
  bio           String?   @db.VarChar(300)
  tag           String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(6)
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  accounts      Account[]

  posts                  Post[]
  drafts                 PostDraft[]
  images                 ImageAsset[]
  likes                  PostLike[]
  comments               Comment[]
  categories             Category[]
  todos                  Todo[]
  sentFriendRequests     Friendship[] @relation("SentFriends")
  receivedFriendRequests Friendship[] @relation("ReceivedFriends")
  notifications          Notification[]
  conversationsA         Conversation[] @relation("ConversationA")
  conversationsB         Conversation[] @relation("ConversationB")
  messages               Message[]

  @@unique([nickname, tag])
}

model Account {
  id                String @id @default(uuid())
  userId            String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)
  @@unique([identifier, token])
}

// 글 공개 범위
enum Visibility {
  PUBLIC    // 전체 공개
  PRIVATE   // 나만 보기 (비밀글)
  FRIENDS   // 친구 공개
}

// 네이버 블로그 스타일 카테고리
model Category {
  id        String   @id @default(uuid())
  name      String   // 카테고리 이름 또는 구분선 "--"
  isDivider Boolean  @default(false) // 구분선 여부
  order     Int      @default(0)     // 순서 정렬
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     Post[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
}

// 게시글 모델
model Post {
  id         String     @id @default(uuid())
  title      String
  tags       String[]   @default([])
  content    String     @db.Text
  visibility Visibility @default(PUBLIC)
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
  drafts     PostDraft[]
  images     PostImage[]
  likes      PostLike[]
  comments   Comment[]
  views      PostView[]

  @@index([authorId])
  @@index([categoryId])
}

model PostDraft {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  postId     String?
  post       Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  title      String     @default("")
  tags       String[]   @default([])
  content    String     @db.Text
  categoryId String?
  visibility Visibility @default(PUBLIC)
  version    Int        @default(1)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
  images     DraftImage[]

  @@unique([userId, key])
  @@index([postId])
}

model PostLike {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@id([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id           String   @id @default(uuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  anonymous    Boolean  @default(false)
  nickname     String
  passwordHash String?
  content      String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  parentId      String?
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
  notifications Notification[]
  @@index([postId, createdAt, id])
  @@index([authorId])
  @@index([parentId])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  commentId   String
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([recipientId, createdAt])
  @@unique([commentId, recipientId])
}

model Conversation {
  id        String @id @default(uuid())
  userAId   String
  userBId   String
  userA     User @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  readA     Int @default(0)
  readB     Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  messages  Message[]
  @@unique([userAId, userBId])
  @@index([userBId, updatedAt])
  @@index([userAId, updatedAt])
}

model Message {
  id             Int @id @default(autoincrement())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientId       String
  content        String @db.VarChar(2000)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  @@unique([senderId, clientId])
  @@index([conversationId, id])
}

model PostView {
  postId     String
  viewerHash String
  day        String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  @@id([postId, viewerHash, day])
  @@index([createdAt, postId])
}

model ActionLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime @db.Timestamptz(6)
}

model ImageAsset {
  name       String       @id
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  orphanedAt DateTime?    @default(now()) @db.Timestamptz(6)
  posts      PostImage[]
  drafts     DraftImage[]

  @@index([orphanedAt])
}

model PostImage {
  postId String
  name   String
  post   Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  image  ImageAsset @relation(fields: [name], references: [name], onDelete: Cascade)
  @@id([postId, name])
  @@index([name])
}

model DraftImage {
  draftId String
  name    String
  draft   PostDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  image   ImageAsset @relation(fields: [name], references: [name], onDelete: Cascade)
  @@id([draftId, name])
  @@index([name])
}

// 친구 관계 상태
enum FriendStatus {
  PENDING   // 친구 요청 중
  ACCEPTED  // 친구 수락됨
}

// 친구 관계 모델
model Friendship {
  id        String       @id @default(uuid())
  userId    String       // 요청자
  friendId  String       // 수신자
  status    FriendStatus @default(PENDING)
  user      User         @relation("SentFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User         @relation("ReceivedFriends", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

// 캘린더 Todo 모델
model Todo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String   // "YYYY-MM-DD" 형태
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId, date])
}
