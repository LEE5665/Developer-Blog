# Database & Redis (Host -> Docker 바인딩 주소)
DATABASE_URL="postgresql://user:userpass@127.0.0.1:5432/developer_blog"
REDIS_URL="redis://127.0.0.1:6379"

# NextAuth (도메인 및 보안 키)
AUTH_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com
AUTH_SECRET=your-random-secret-at-least-32-chars
TRUST_PROXY=true

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 (S3-compatible, 선택사항)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=developer-blog
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 이메일 인증 SMTP (선택사항)
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

